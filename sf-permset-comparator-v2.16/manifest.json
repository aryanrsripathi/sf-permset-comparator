{
  "manifest_version": 3,
  "name": "SF Permission Set Comparator",
  "version": "2.6.1",
  "description": "Auto-detects your logged-in Salesforce orgs and compares a permission set between any two of them.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.cloudforce.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Permission Set Comparator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
